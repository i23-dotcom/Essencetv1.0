    <!-- Settings: network / VPN -->
    <string name="network_section_title">Network</string>
    <string name="vpn_info_title">Using a VPN?</string>
    <string name="vpn_info_body">Essence TV doesn\'t need its own VPN. Turn one on from your device\'s network settings (or any VPN app you already have installed) and Android automatically routes every app\'s traffic through it, including this one - no extra setup needed here.</string>

    <!-- Settings: buffer / lag reduction -->
    <string name="buffer_section_title">Streaming smoothness</string>
    <string name="buffer_section_body">Essence TV pre-buffers a few seconds of each stream before playback starts, so brief network slow-downs don\'t cause stuttering. A longer buffer means smoother playback but a slower channel-change.</string>
    <string name="buffer_low">Fastest\n(~5s)</string>
    <string name="buffer_balanced">Balanced\n(~15s)</string>
    <string name="buffer_smooth">Smoothest\n(~30s)</string>
